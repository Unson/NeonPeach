;; Neon Peach LSTM trainer kernels (WebAssembly SIMD).
;; Four training clips run side by side: every value is an f32x4 holding the same moment of four clips.
;; Weights are shared (plain f32). Gradients are kept per clip (f32x4) and summed by the caller.
;; Layout of W: row-major 4H x (1+H), input column first. Gates in order i, f, g, o.
;; A record holds one time step: i, f, g, o (4H), c (H), tanh(c) (H), h (H)  -> 7H vectors.
(module
  (memory (export "mem") 256)

  (func $vtanh (param $x v128) (result v128)
    (local $x2 v128) (local $p v128) (local $q v128)
    (local.set $x (f32x4.min (f32x4.max (local.get $x) (v128.const f32x4 -7.99881172180175781 -7.99881172180175781 -7.99881172180175781 -7.99881172180175781))
                             (v128.const f32x4 7.99881172180175781 7.99881172180175781 7.99881172180175781 7.99881172180175781)))
    (local.set $x2 (f32x4.mul (local.get $x) (local.get $x)))
    (local.set $p (v128.const f32x4 -2.76076847742355e-16 -2.76076847742355e-16 -2.76076847742355e-16 -2.76076847742355e-16))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 2.00018790482477e-13 2.00018790482477e-13 2.00018790482477e-13 2.00018790482477e-13)))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 -8.60467152213735e-11 -8.60467152213735e-11 -8.60467152213735e-11 -8.60467152213735e-11)))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 5.12229709037114e-08 5.12229709037114e-08 5.12229709037114e-08 5.12229709037114e-08)))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 1.48572235717979e-05 1.48572235717979e-05 1.48572235717979e-05 1.48572235717979e-05)))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 6.37261928875436e-04 6.37261928875436e-04 6.37261928875436e-04 6.37261928875436e-04)))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 4.89352455891786e-03 4.89352455891786e-03 4.89352455891786e-03 4.89352455891786e-03)))
    (local.set $p (f32x4.mul (local.get $x) (local.get $p)))
    (local.set $q (v128.const f32x4 1.19825839466702e-06 1.19825839466702e-06 1.19825839466702e-06 1.19825839466702e-06))
    (local.set $q (f32x4.add (f32x4.mul (local.get $x2) (local.get $q)) (v128.const f32x4 1.18534705686654e-04 1.18534705686654e-04 1.18534705686654e-04 1.18534705686654e-04)))
    (local.set $q (f32x4.add (f32x4.mul (local.get $x2) (local.get $q)) (v128.const f32x4 2.26843463243900e-03 2.26843463243900e-03 2.26843463243900e-03 2.26843463243900e-03)))
    (local.set $q (f32x4.add (f32x4.mul (local.get $x2) (local.get $q)) (v128.const f32x4 4.89352518554385e-03 4.89352518554385e-03 4.89352518554385e-03 4.89352518554385e-03)))
    (f32x4.div (local.get $p) (local.get $q))
  )
  (func $sig (param $x v128) (result v128)
    (f32x4.add (v128.const f32x4 0.5 0.5 0.5 0.5)
      (f32x4.mul (v128.const f32x4 0.5 0.5 0.5 0.5) (call $vtanh (f32x4.mul (v128.const f32x4 0.5 0.5 0.5 0.5) (local.get $x))))))

  ;; Forward pass over T steps. Steps from $warm on are stored as records 1..T-warm; record 0 holds the
  ;; state (c, h) right before the first stored step. Predictions for stored steps go to $Yh.
  (func (export "fwd")
    (param $W i32) (param $b i32) (param $hw i32) (param $hb f32) (param $H i32)
    (param $X i32) (param $T i32) (param $warm i32) (param $S i32) (param $Yh i32)
    (param $a i32) (param $hc i32) (param $cc i32) (param $keep i32)
    (local $cols i32) (local $G i32) (local $t i32) (local $r i32) (local $k i32) (local $wr i32) (local $rec i32)
    (local $Hb i32) (local $rb i32) (local $xv v128) (local $acc v128)
    (local $iv v128) (local $fv v128) (local $gv v128) (local $ov v128) (local $cv v128) (local $tv v128) (local $hv v128)
    (local.set $cols (i32.add (local.get $H) (i32.const 1)))
    (local.set $G (i32.shl (local.get $H) (i32.const 2)))
    (local.set $Hb (i32.shl (local.get $H) (i32.const 4)))
    (local.set $rb (i32.mul (local.get $Hb) (i32.const 7)))
    (local.set $k (i32.const 0))
    (block $zd (loop $zl
      (br_if $zd (i32.ge_u (local.get $k) (local.get $Hb)))
      (v128.store (i32.add (local.get $hc) (local.get $k)) (v128.const f32x4 0 0 0 0))
      (v128.store (i32.add (local.get $cc) (local.get $k)) (v128.const f32x4 0 0 0 0))
      (v128.store (i32.add (i32.add (local.get $S) (i32.shl (local.get $Hb) (i32.const 2))) (local.get $k)) (v128.const f32x4 0 0 0 0))
      (v128.store (i32.add (i32.add (local.get $S) (i32.mul (local.get $Hb) (i32.const 6))) (local.get $k)) (v128.const f32x4 0 0 0 0))
      (local.set $k (i32.add (local.get $k) (i32.const 16)))
      (br $zl)))
    (local.set $t (i32.const 0))
    (block $td (loop $tl
      (br_if $td (i32.ge_u (local.get $t) (local.get $T)))
      (local.set $xv (v128.load (i32.add (local.get $X) (i32.shl (local.get $t) (i32.const 4)))))
      ;; a = b + W [x, h]
      (local.set $r (i32.const 0))
      (block $rd (loop $rl
        (br_if $rd (i32.ge_u (local.get $r) (local.get $G)))
        (local.set $wr (i32.add (local.get $W) (i32.shl (i32.mul (local.get $r) (local.get $cols)) (i32.const 2))))
        (local.set $acc (f32x4.add (v128.load32_splat (i32.add (local.get $b) (i32.shl (local.get $r) (i32.const 2))))
                                   (f32x4.mul (v128.load32_splat (local.get $wr)) (local.get $xv))))
        (local.set $k (i32.const 0))
        (block $kd (loop $kl
          (br_if $kd (i32.ge_u (local.get $k) (local.get $H)))
          (local.set $acc (f32x4.add (local.get $acc)
            (f32x4.mul (v128.load32_splat (i32.add (local.get $wr) (i32.shl (i32.add (local.get $k) (i32.const 1)) (i32.const 2))))
                       (v128.load (i32.add (local.get $hc) (i32.shl (local.get $k) (i32.const 4)))))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $kl)))
        (v128.store (i32.add (local.get $a) (i32.shl (local.get $r) (i32.const 4))) (local.get $acc))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $rl)))
      (local.set $rec (i32.add (local.get $S) (i32.mul (i32.add (i32.sub (local.get $t) (local.get $warm)) (i32.const 1)) (local.get $rb))))
      (local.set $k (i32.const 0))
      (block $ed (loop $el
        (br_if $ed (i32.ge_u (local.get $k) (local.get $Hb)))
        (local.set $iv (call $sig (v128.load (i32.add (local.get $a) (local.get $k)))))
        (local.set $fv (call $sig (v128.load (i32.add (i32.add (local.get $a) (local.get $Hb)) (local.get $k)))))
        (local.set $gv (call $vtanh (v128.load (i32.add (i32.add (local.get $a) (i32.shl (local.get $Hb) (i32.const 1))) (local.get $k)))))
        (local.set $ov (call $sig (v128.load (i32.add (i32.add (local.get $a) (i32.mul (local.get $Hb) (i32.const 3))) (local.get $k)))))
        (local.set $cv (f32x4.add (f32x4.mul (local.get $fv) (v128.load (i32.add (local.get $cc) (local.get $k)))) (f32x4.mul (local.get $iv) (local.get $gv))))
        (local.set $tv (call $vtanh (local.get $cv)))
        (local.set $hv (f32x4.mul (local.get $ov) (local.get $tv)))
        (v128.store (i32.add (local.get $cc) (local.get $k)) (local.get $cv))
        (v128.store (i32.add (local.get $hc) (local.get $k)) (local.get $hv))
        (if (i32.and (local.get $keep) (i32.ge_s (local.get $t) (local.get $warm))) (then
          (v128.store (i32.add (local.get $rec) (local.get $k)) (local.get $iv))
          (v128.store (i32.add (i32.add (local.get $rec) (local.get $Hb)) (local.get $k)) (local.get $fv))
          (v128.store (i32.add (i32.add (local.get $rec) (i32.shl (local.get $Hb) (i32.const 1))) (local.get $k)) (local.get $gv))
          (v128.store (i32.add (i32.add (local.get $rec) (i32.mul (local.get $Hb) (i32.const 3))) (local.get $k)) (local.get $ov))
          (v128.store (i32.add (i32.add (local.get $rec) (i32.shl (local.get $Hb) (i32.const 2))) (local.get $k)) (local.get $cv))
          (v128.store (i32.add (i32.add (local.get $rec) (i32.mul (local.get $Hb) (i32.const 5))) (local.get $k)) (local.get $tv))
          (v128.store (i32.add (i32.add (local.get $rec) (i32.mul (local.get $Hb) (i32.const 6))) (local.get $k)) (local.get $hv))))
        (if (i32.and (local.get $keep) (i32.eq (local.get $t) (i32.sub (local.get $warm) (i32.const 1)))) (then
          (v128.store (i32.add (i32.add (local.get $S) (i32.shl (local.get $Hb) (i32.const 2))) (local.get $k)) (local.get $cv))
          (v128.store (i32.add (i32.add (local.get $S) (i32.mul (local.get $Hb) (i32.const 6))) (local.get $k)) (local.get $hv))))
        (local.set $k (i32.add (local.get $k) (i32.const 16)))
        (br $el)))
      (if (i32.ge_s (local.get $t) (local.get $warm)) (then
        (local.set $acc (f32x4.splat (local.get $hb)))
        (local.set $k (i32.const 0))
        (block $yd (loop $yl
          (br_if $yd (i32.ge_u (local.get $k) (local.get $H)))
          (local.set $acc (f32x4.add (local.get $acc)
            (f32x4.mul (v128.load32_splat (i32.add (local.get $hw) (i32.shl (local.get $k) (i32.const 2))))
                       (v128.load (i32.add (local.get $hc) (i32.shl (local.get $k) (i32.const 4)))))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $yl)))
        (v128.store (i32.add (local.get $Yh) (i32.shl (i32.sub (local.get $t) (local.get $warm)) (i32.const 4))) (local.get $acc))))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br $tl)))
  )

  ;; Backward pass through the stored records. $DY holds dLoss/dPrediction for each stored step.
  ;; Adds into dW (4H x (1+H) vectors), db (4H), dhw (H) and dhb (1). $dc and $dhn must start at zero.
  (func (export "bwd")
    (param $W i32) (param $hw i32) (param $H i32) (param $X i32) (param $warm i32) (param $Tg i32)
    (param $S i32) (param $DY i32) (param $dW i32) (param $db i32) (param $dhw i32) (param $dhb i32)
    (param $da i32) (param $dc i32) (param $dhn i32)
    (local $cols i32) (local $G i32) (local $Hb i32) (local $rb i32) (local $s i32) (local $rec i32) (local $prv i32)
    (local $k i32) (local $r i32) (local $wr i32) (local $dwr i32) (local $kb i32)
    (local $dy v128) (local $dh v128) (local $iv v128) (local $fv v128) (local $gv v128) (local $ov v128) (local $tv v128)
    (local $cp v128) (local $dcv v128) (local $dar v128) (local $xv v128) (local $one v128) (local $p i32)
    (local.set $one (v128.const f32x4 1 1 1 1))
    (local.set $cols (i32.add (local.get $H) (i32.const 1)))
    (local.set $G (i32.shl (local.get $H) (i32.const 2)))
    (local.set $Hb (i32.shl (local.get $H) (i32.const 4)))
    (local.set $rb (i32.mul (local.get $Hb) (i32.const 7)))
    (local.set $s (local.get $Tg))
    (block $sd (loop $sl
      (br_if $sd (i32.lt_s (local.get $s) (i32.const 1)))
      (local.set $rec (i32.add (local.get $S) (i32.mul (local.get $s) (local.get $rb))))
      (local.set $prv (i32.sub (local.get $rec) (local.get $rb)))
      (local.set $dy (v128.load (i32.add (local.get $DY) (i32.shl (i32.sub (local.get $s) (i32.const 1)) (i32.const 4)))))
      (v128.store (local.get $dhb) (f32x4.add (v128.load (local.get $dhb)) (local.get $dy)))
      (local.set $k (i32.const 0))
      (block $kd (loop $kl
        (br_if $kd (i32.ge_u (local.get $k) (local.get $H)))
        (local.set $kb (i32.shl (local.get $k) (i32.const 4)))
        (v128.store (i32.add (local.get $dhw) (local.get $kb))
          (f32x4.add (v128.load (i32.add (local.get $dhw) (local.get $kb)))
                     (f32x4.mul (local.get $dy) (v128.load (i32.add (i32.add (local.get $rec) (i32.mul (local.get $Hb) (i32.const 6))) (local.get $kb))))))
        (local.set $dh (f32x4.add (f32x4.mul (v128.load32_splat (i32.add (local.get $hw) (i32.shl (local.get $k) (i32.const 2)))) (local.get $dy))
                                  (v128.load (i32.add (local.get $dhn) (local.get $kb)))))
        (local.set $iv (v128.load (i32.add (local.get $rec) (local.get $kb))))
        (local.set $fv (v128.load (i32.add (i32.add (local.get $rec) (local.get $Hb)) (local.get $kb))))
        (local.set $gv (v128.load (i32.add (i32.add (local.get $rec) (i32.shl (local.get $Hb) (i32.const 1))) (local.get $kb))))
        (local.set $ov (v128.load (i32.add (i32.add (local.get $rec) (i32.mul (local.get $Hb) (i32.const 3))) (local.get $kb))))
        (local.set $tv (v128.load (i32.add (i32.add (local.get $rec) (i32.mul (local.get $Hb) (i32.const 5))) (local.get $kb))))
        (local.set $cp (v128.load (i32.add (i32.add (local.get $prv) (i32.shl (local.get $Hb) (i32.const 2))) (local.get $kb))))
        ;; o gate
        (v128.store (i32.add (i32.add (local.get $da) (i32.mul (local.get $Hb) (i32.const 3))) (local.get $kb))
          (f32x4.mul (f32x4.mul (local.get $dh) (local.get $tv)) (f32x4.mul (local.get $ov) (f32x4.sub (local.get $one) (local.get $ov)))))
        ;; cell
        (local.set $dcv (f32x4.add (f32x4.mul (f32x4.mul (local.get $dh) (local.get $ov)) (f32x4.sub (local.get $one) (f32x4.mul (local.get $tv) (local.get $tv))))
                                   (v128.load (i32.add (local.get $dc) (local.get $kb)))))
        ;; i gate
        (v128.store (i32.add (local.get $da) (local.get $kb))
          (f32x4.mul (f32x4.mul (local.get $dcv) (local.get $gv)) (f32x4.mul (local.get $iv) (f32x4.sub (local.get $one) (local.get $iv)))))
        ;; f gate
        (v128.store (i32.add (i32.add (local.get $da) (local.get $Hb)) (local.get $kb))
          (f32x4.mul (f32x4.mul (local.get $dcv) (local.get $cp)) (f32x4.mul (local.get $fv) (f32x4.sub (local.get $one) (local.get $fv)))))
        ;; g gate
        (v128.store (i32.add (i32.add (local.get $da) (i32.shl (local.get $Hb) (i32.const 1))) (local.get $kb))
          (f32x4.mul (f32x4.mul (local.get $dcv) (local.get $iv)) (f32x4.sub (local.get $one) (f32x4.mul (local.get $gv) (local.get $gv)))))
        (v128.store (i32.add (local.get $dc) (local.get $kb)) (f32x4.mul (local.get $dcv) (local.get $fv)))
        (v128.store (i32.add (local.get $dhn) (local.get $kb)) (v128.const f32x4 0 0 0 0))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $kl)))
      ;; weight gradients and the gradient into the previous hidden state
      (local.set $xv (v128.load (i32.add (local.get $X) (i32.shl (i32.sub (i32.add (local.get $warm) (local.get $s)) (i32.const 1)) (i32.const 4)))))
      (local.set $p (i32.add (local.get $prv) (i32.mul (local.get $Hb) (i32.const 6))))
      (local.set $r (i32.const 0))
      (block $rd (loop $rl
        (br_if $rd (i32.ge_u (local.get $r) (local.get $G)))
        (local.set $dar (v128.load (i32.add (local.get $da) (i32.shl (local.get $r) (i32.const 4)))))
        (v128.store (i32.add (local.get $db) (i32.shl (local.get $r) (i32.const 4)))
          (f32x4.add (v128.load (i32.add (local.get $db) (i32.shl (local.get $r) (i32.const 4)))) (local.get $dar)))
        (local.set $wr (i32.add (local.get $W) (i32.shl (i32.mul (local.get $r) (local.get $cols)) (i32.const 2))))
        (local.set $dwr (i32.add (local.get $dW) (i32.shl (i32.mul (local.get $r) (local.get $cols)) (i32.const 4))))
        (v128.store (local.get $dwr) (f32x4.add (v128.load (local.get $dwr)) (f32x4.mul (local.get $dar) (local.get $xv))))
        (local.set $k (i32.const 0))
        (block $jd (loop $jl
          (br_if $jd (i32.ge_u (local.get $k) (local.get $H)))
          (local.set $kb (i32.shl (local.get $k) (i32.const 4)))
          (v128.store offset=16 (i32.add (local.get $dwr) (local.get $kb))
            (f32x4.add (v128.load offset=16 (i32.add (local.get $dwr) (local.get $kb)))
                       (f32x4.mul (local.get $dar) (v128.load (i32.add (local.get $p) (local.get $kb))))))
          (v128.store (i32.add (local.get $dhn) (local.get $kb))
            (f32x4.add (v128.load (i32.add (local.get $dhn) (local.get $kb)))
                       (f32x4.mul (v128.load32_splat offset=4 (i32.add (local.get $wr) (i32.shl (local.get $k) (i32.const 2)))) (local.get $dar))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $jl)))
        (local.set $r (i32.add (local.get $r) (i32.const 1)))
        (br $rl)))
      (local.set $s (i32.sub (local.get $s) (i32.const 1)))
      (br $sl)))
  )
)
