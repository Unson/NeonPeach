;; Neon Peach neural kernels (WebAssembly SIMD).
;; Layout: every signal is a set of rows of f32 along time. Row r of a buffer starts at ptr + r*stride (bytes).
;; All frame counts are multiples of 16. All pointers are byte offsets into this module's memory.
(module
  (memory (export "mem") 64)

  ;; y[r][t] = (bias ? bias[r] : 0) + (acc ? y[r][t] : 0)
  ;;           + sum_k sum_c W[k][r][c] * x[c][t - dil*(K-1-k)]
  ;; W is stored as K matrices of rows x cols, row-major. K=1, dil=0 gives a plain matrix multiply.
  (func (export "conv")
    (param $w i32) (param $K i32) (param $rows i32) (param $cols i32) (param $dil i32)
    (param $x i32) (param $xs i32) (param $y i32) (param $ys i32) (param $n i32)
    (param $bias i32) (param $acc i32)
    (local $r i32) (local $t i32) (local $k i32) (local $c i32)
    (local $nb i32) (local $yp i32) (local $xp i32) (local $wp i32) (local $mat i32)
    (local $s0 v128) (local $s1 v128) (local $s2 v128) (local $s3 v128) (local $wv v128) (local $b v128)
    (local $yq i32) (local $wq i32) (local $u0 v128) (local $u1 v128) (local $u2 v128) (local $u3 v128) (local $wu v128) (local $b2 v128)
    (local $x0 v128) (local $x1 v128) (local $x2 v128) (local $x3 v128)
    (local.set $nb (i32.shl (local.get $n) (i32.const 2)))
    (local.set $mat (i32.shl (i32.mul (local.get $rows) (local.get $cols)) (i32.const 2)))
    ;; two output rows at a time: each input load feeds both rows
    (local.set $r (i32.const 0))
    (block $pd (loop $pl
      (br_if $pd (i32.ge_u (i32.add (local.get $r) (i32.const 1)) (local.get $rows)))
      (local.set $yp (i32.add (local.get $y) (i32.mul (local.get $r) (local.get $ys))))
      (local.set $yq (i32.add (local.get $yp) (local.get $ys)))
      (if (local.get $bias)
        (then (local.set $b (f32x4.splat (f32.load (i32.add (local.get $bias) (i32.shl (local.get $r) (i32.const 2))))))
              (local.set $b2 (f32x4.splat (f32.load offset=4 (i32.add (local.get $bias) (i32.shl (local.get $r) (i32.const 2)))))))
        (else (local.set $b (v128.const f32x4 0 0 0 0)) (local.set $b2 (v128.const f32x4 0 0 0 0))))
      (local.set $t (i32.const 0))
      (block $td2 (loop $tl2
        (br_if $td2 (i32.ge_u (local.get $t) (local.get $nb)))
        (if (local.get $acc)
          (then
            (local.set $s0 (f32x4.add (local.get $b) (v128.load (i32.add (local.get $yp) (local.get $t)))))
            (local.set $s1 (f32x4.add (local.get $b) (v128.load offset=16 (i32.add (local.get $yp) (local.get $t)))))
            (local.set $s2 (f32x4.add (local.get $b) (v128.load offset=32 (i32.add (local.get $yp) (local.get $t)))))
            (local.set $s3 (f32x4.add (local.get $b) (v128.load offset=48 (i32.add (local.get $yp) (local.get $t))))))
          (else
            (local.set $s0 (local.get $b)) (local.set $s1 (local.get $b))
            (local.set $s2 (local.get $b)) (local.set $s3 (local.get $b))))
        (if (local.get $acc)
          (then
            (local.set $u0 (f32x4.add (local.get $b2) (v128.load (i32.add (local.get $yq) (local.get $t)))))
            (local.set $u1 (f32x4.add (local.get $b2) (v128.load offset=16 (i32.add (local.get $yq) (local.get $t)))))
            (local.set $u2 (f32x4.add (local.get $b2) (v128.load offset=32 (i32.add (local.get $yq) (local.get $t)))))
            (local.set $u3 (f32x4.add (local.get $b2) (v128.load offset=48 (i32.add (local.get $yq) (local.get $t))))))
          (else
            (local.set $u0 (local.get $b2)) (local.set $u1 (local.get $b2))
            (local.set $u2 (local.get $b2)) (local.set $u3 (local.get $b2))))
        (local.set $k (i32.const 0))
        (block $kd2 (loop $kl2
          (br_if $kd2 (i32.ge_u (local.get $k) (local.get $K)))
          (local.set $xp (i32.add (i32.add (local.get $x) (local.get $t))
            (i32.shl (i32.mul (local.get $dil) (i32.sub (i32.add (local.get $k) (i32.const 1)) (local.get $K))) (i32.const 2))))
          (local.set $wp (i32.add (i32.add (local.get $w) (i32.mul (local.get $k) (local.get $mat)))
            (i32.shl (i32.mul (local.get $r) (local.get $cols)) (i32.const 2))))
          (local.set $wq (i32.add (local.get $wp) (i32.shl (local.get $cols) (i32.const 2))))
          (local.set $c (i32.const 0))
          (block $cd2 (loop $cl2
            (br_if $cd2 (i32.ge_u (local.get $c) (local.get $cols)))
            (local.set $wv (v128.load32_splat (local.get $wp)))
            (local.set $wu (v128.load32_splat (local.get $wq)))
            (local.set $x0 (v128.load (local.get $xp))) (local.set $x1 (v128.load offset=16 (local.get $xp)))
            (local.set $x2 (v128.load offset=32 (local.get $xp))) (local.set $x3 (v128.load offset=48 (local.get $xp)))
            (local.set $s0 (f32x4.add (local.get $s0) (f32x4.mul (local.get $wv) (local.get $x0))))
            (local.set $u0 (f32x4.add (local.get $u0) (f32x4.mul (local.get $wu) (local.get $x0))))
            (local.set $s1 (f32x4.add (local.get $s1) (f32x4.mul (local.get $wv) (local.get $x1))))
            (local.set $u1 (f32x4.add (local.get $u1) (f32x4.mul (local.get $wu) (local.get $x1))))
            (local.set $s2 (f32x4.add (local.get $s2) (f32x4.mul (local.get $wv) (local.get $x2))))
            (local.set $u2 (f32x4.add (local.get $u2) (f32x4.mul (local.get $wu) (local.get $x2))))
            (local.set $s3 (f32x4.add (local.get $s3) (f32x4.mul (local.get $wv) (local.get $x3))))
            (local.set $u3 (f32x4.add (local.get $u3) (f32x4.mul (local.get $wu) (local.get $x3))))
            (local.set $xp (i32.add (local.get $xp) (local.get $xs)))
            (local.set $wp (i32.add (local.get $wp) (i32.const 4)))
            (local.set $wq (i32.add (local.get $wq) (i32.const 4)))
            (local.set $c (i32.add (local.get $c) (i32.const 1)))
            (br $cl2)))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $kl2)))
        (v128.store (i32.add (local.get $yp) (local.get $t)) (local.get $s0))
        (v128.store offset=16 (i32.add (local.get $yp) (local.get $t)) (local.get $s1))
        (v128.store offset=32 (i32.add (local.get $yp) (local.get $t)) (local.get $s2))
        (v128.store offset=48 (i32.add (local.get $yp) (local.get $t)) (local.get $s3))
        (v128.store (i32.add (local.get $yq) (local.get $t)) (local.get $u0))
        (v128.store offset=16 (i32.add (local.get $yq) (local.get $t)) (local.get $u1))
        (v128.store offset=32 (i32.add (local.get $yq) (local.get $t)) (local.get $u2))
        (v128.store offset=48 (i32.add (local.get $yq) (local.get $t)) (local.get $u3))
        (local.set $t (i32.add (local.get $t) (i32.const 64)))
        (br $tl2)))
      (local.set $r (i32.add (local.get $r) (i32.const 2)))
      (br $pl)))
    ;; an odd last row goes through the one-row loop below
    (local.set $r (i32.and (local.get $rows) (i32.const -2)))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $r) (local.get $rows)))
      (local.set $yp (i32.add (local.get $y) (i32.mul (local.get $r) (local.get $ys))))
      (if (local.get $bias)
        (then (local.set $b (f32x4.splat (f32.load (i32.add (local.get $bias) (i32.shl (local.get $r) (i32.const 2)))))))
        (else (local.set $b (v128.const f32x4 0 0 0 0))))
      (local.set $t (i32.const 0))
      (block $td (loop $tl
        (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
        (if (local.get $acc)
          (then
            (local.set $s0 (f32x4.add (local.get $b) (v128.load (i32.add (local.get $yp) (local.get $t)))))
            (local.set $s1 (f32x4.add (local.get $b) (v128.load offset=16 (i32.add (local.get $yp) (local.get $t)))))
            (local.set $s2 (f32x4.add (local.get $b) (v128.load offset=32 (i32.add (local.get $yp) (local.get $t)))))
            (local.set $s3 (f32x4.add (local.get $b) (v128.load offset=48 (i32.add (local.get $yp) (local.get $t))))))
          (else
            (local.set $s0 (local.get $b)) (local.set $s1 (local.get $b))
            (local.set $s2 (local.get $b)) (local.set $s3 (local.get $b))))
        (local.set $k (i32.const 0))
        (block $kd (loop $kl
          (br_if $kd (i32.ge_u (local.get $k) (local.get $K)))
          ;; tap k reads x at t - dil*(K-1-k)
          (local.set $xp (i32.add (i32.add (local.get $x) (local.get $t))
            (i32.shl (i32.mul (local.get $dil) (i32.sub (i32.add (local.get $k) (i32.const 1)) (local.get $K))) (i32.const 2))))
          (local.set $wp (i32.add (i32.add (local.get $w) (i32.mul (local.get $k) (local.get $mat)))
            (i32.shl (i32.mul (local.get $r) (local.get $cols)) (i32.const 2))))
          (local.set $c (i32.const 0))
          (block $cd (loop $cl
            (br_if $cd (i32.ge_u (local.get $c) (local.get $cols)))
            (local.set $wv (v128.load32_splat (local.get $wp)))
            (local.set $s0 (f32x4.add (local.get $s0) (f32x4.mul (local.get $wv) (v128.load (local.get $xp)))))
            (local.set $s1 (f32x4.add (local.get $s1) (f32x4.mul (local.get $wv) (v128.load offset=16 (local.get $xp)))))
            (local.set $s2 (f32x4.add (local.get $s2) (f32x4.mul (local.get $wv) (v128.load offset=32 (local.get $xp)))))
            (local.set $s3 (f32x4.add (local.get $s3) (f32x4.mul (local.get $wv) (v128.load offset=48 (local.get $xp)))))
            (local.set $xp (i32.add (local.get $xp) (local.get $xs)))
            (local.set $wp (i32.add (local.get $wp) (i32.const 4)))
            (local.set $c (i32.add (local.get $c) (i32.const 1)))
            (br $cl)))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $kl)))
        (v128.store (i32.add (local.get $yp) (local.get $t)) (local.get $s0))
        (v128.store offset=16 (i32.add (local.get $yp) (local.get $t)) (local.get $s1))
        (v128.store offset=32 (i32.add (local.get $yp) (local.get $t)) (local.get $s2))
        (v128.store offset=48 (i32.add (local.get $yp) (local.get $t)) (local.get $s3))
        (local.set $t (i32.add (local.get $t) (i32.const 64)))
        (br $tl)))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $rl)))
  )

;; Weight gradient for 1x1 convs, two rows by two columns at a time: every load feeds two products.
  (func $wgrad1b (param $dw i32) (param $rows i32) (param $cols i32) (param $x i32) (param $xs i32) (param $dy i32) (param $dys i32) (param $n i32)
    (local $r i32) (local $c i32) (local $t i32) (local $nb i32) (local $y0p i32) (local $y1p i32) (local $x0p i32) (local $x1p i32) (local $wp i32)
    (local $y0a v128) (local $y0b v128) (local $y1a v128) (local $y1b v128) (local $x0a v128) (local $x0b v128) (local $x1a v128) (local $x1b v128)
    (local $a00 v128) (local $a01 v128) (local $a10 v128) (local $a11 v128) (local $b00 v128) (local $b01 v128) (local $b10 v128) (local $b11 v128)
    (local.set $nb (i32.shl (local.get $n) (i32.const 2)))
    (local.set $r (i32.const 0))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $r) (local.get $rows)))
      (local.set $y0p (i32.add (local.get $dy) (i32.mul (local.get $r) (local.get $dys))))
      (local.set $y1p (i32.add (local.get $y0p) (local.get $dys)))
      (local.set $c (i32.const 0))
      (block $cd (loop $cl
        (br_if $cd (i32.ge_u (local.get $c) (local.get $cols)))
        (local.set $x0p (i32.add (local.get $x) (i32.mul (local.get $c) (local.get $xs))))
        (local.set $x1p (i32.add (local.get $x0p) (local.get $xs)))
        (local.set $a00 (v128.const f32x4 0 0 0 0)) (local.set $a01 (v128.const f32x4 0 0 0 0)) (local.set $a10 (v128.const f32x4 0 0 0 0)) (local.set $a11 (v128.const f32x4 0 0 0 0)) (local.set $b00 (v128.const f32x4 0 0 0 0)) (local.set $b01 (v128.const f32x4 0 0 0 0)) (local.set $b10 (v128.const f32x4 0 0 0 0)) (local.set $b11 (v128.const f32x4 0 0 0 0))
        (local.set $t (i32.const 0))
        (block $td (loop $tl
          (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
            (local.set $y0a (v128.load (i32.add (local.get $y0p) (local.get $t)))) (local.set $y0b (v128.load offset=16 (i32.add (local.get $y0p) (local.get $t))))
            (local.set $y1a (v128.load (i32.add (local.get $y1p) (local.get $t)))) (local.set $y1b (v128.load offset=16 (i32.add (local.get $y1p) (local.get $t))))
            (local.set $x0a (v128.load (i32.add (local.get $x0p) (local.get $t)))) (local.set $x0b (v128.load offset=16 (i32.add (local.get $x0p) (local.get $t))))
            (local.set $x1a (v128.load (i32.add (local.get $x1p) (local.get $t)))) (local.set $x1b (v128.load offset=16 (i32.add (local.get $x1p) (local.get $t))))
            (local.set $a00 (f32x4.add (local.get $a00) (f32x4.mul (local.get $y0a) (local.get $x0a))))
            (local.set $b00 (f32x4.add (local.get $b00) (f32x4.mul (local.get $y0b) (local.get $x0b))))
            (local.set $a01 (f32x4.add (local.get $a01) (f32x4.mul (local.get $y0a) (local.get $x1a))))
            (local.set $b01 (f32x4.add (local.get $b01) (f32x4.mul (local.get $y0b) (local.get $x1b))))
            (local.set $a10 (f32x4.add (local.get $a10) (f32x4.mul (local.get $y1a) (local.get $x0a))))
            (local.set $b10 (f32x4.add (local.get $b10) (f32x4.mul (local.get $y1b) (local.get $x0b))))
            (local.set $a11 (f32x4.add (local.get $a11) (f32x4.mul (local.get $y1a) (local.get $x1a))))
            (local.set $b11 (f32x4.add (local.get $b11) (f32x4.mul (local.get $y1b) (local.get $x1b))))
          (local.set $t (i32.add (local.get $t) (i32.const 32)))
          (br $tl)))
          (local.set $wp (i32.add (local.get $dw) (i32.shl (i32.add (i32.mul (i32.add (local.get $r) (i32.const 0)) (local.get $cols)) (i32.add (local.get $c) (i32.const 0))) (i32.const 2))))
          (f32.store (local.get $wp) (f32.add (f32.load (local.get $wp)) (f32.add (f32.add (f32x4.extract_lane 0 (f32x4.add (local.get $a00) (local.get $b00))) (f32x4.extract_lane 1 (f32x4.add (local.get $a00) (local.get $b00)))) (f32.add (f32x4.extract_lane 2 (f32x4.add (local.get $a00) (local.get $b00))) (f32x4.extract_lane 3 (f32x4.add (local.get $a00) (local.get $b00)))))))
          (local.set $wp (i32.add (local.get $dw) (i32.shl (i32.add (i32.mul (i32.add (local.get $r) (i32.const 0)) (local.get $cols)) (i32.add (local.get $c) (i32.const 1))) (i32.const 2))))
          (f32.store (local.get $wp) (f32.add (f32.load (local.get $wp)) (f32.add (f32.add (f32x4.extract_lane 0 (f32x4.add (local.get $a01) (local.get $b01))) (f32x4.extract_lane 1 (f32x4.add (local.get $a01) (local.get $b01)))) (f32.add (f32x4.extract_lane 2 (f32x4.add (local.get $a01) (local.get $b01))) (f32x4.extract_lane 3 (f32x4.add (local.get $a01) (local.get $b01)))))))
          (local.set $wp (i32.add (local.get $dw) (i32.shl (i32.add (i32.mul (i32.add (local.get $r) (i32.const 1)) (local.get $cols)) (i32.add (local.get $c) (i32.const 0))) (i32.const 2))))
          (f32.store (local.get $wp) (f32.add (f32.load (local.get $wp)) (f32.add (f32.add (f32x4.extract_lane 0 (f32x4.add (local.get $a10) (local.get $b10))) (f32x4.extract_lane 1 (f32x4.add (local.get $a10) (local.get $b10)))) (f32.add (f32x4.extract_lane 2 (f32x4.add (local.get $a10) (local.get $b10))) (f32x4.extract_lane 3 (f32x4.add (local.get $a10) (local.get $b10)))))))
          (local.set $wp (i32.add (local.get $dw) (i32.shl (i32.add (i32.mul (i32.add (local.get $r) (i32.const 1)) (local.get $cols)) (i32.add (local.get $c) (i32.const 1))) (i32.const 2))))
          (f32.store (local.get $wp) (f32.add (f32.load (local.get $wp)) (f32.add (f32.add (f32x4.extract_lane 0 (f32x4.add (local.get $a11) (local.get $b11))) (f32x4.extract_lane 1 (f32x4.add (local.get $a11) (local.get $b11)))) (f32.add (f32x4.extract_lane 2 (f32x4.add (local.get $a11) (local.get $b11))) (f32x4.extract_lane 3 (f32x4.add (local.get $a11) (local.get $b11)))))))
        (local.set $c (i32.add (local.get $c) (i32.const 2)))
        (br $cl)))
      (local.set $r (i32.add (local.get $r) (i32.const 2)))
      (br $rl)))
  )

  ;; Weight gradient for kernel size 3: all three taps in one pass, so dY is read once.
  (func $wgrad3 (param $dw i32) (param $rows i32) (param $cols i32) (param $dil i32) (param $x i32) (param $xs i32) (param $dy i32) (param $dys i32) (param $n i32)
    (local $r i32) (local $c i32) (local $t i32) (local $nb i32) (local $yp i32) (local $xp i32) (local $wp i32) (local $mat i32) (local $o1 i32) (local $o2 i32) (local $rc i32)
    (local $y0 v128) (local $y1 v128) (local $a0 v128) (local $a1 v128) (local $b0 v128) (local $b1 v128) (local $e0 v128) (local $e1 v128) (local $q i32)
    (local.set $nb (i32.shl (local.get $n) (i32.const 2)))
    (local.set $mat (i32.shl (i32.mul (local.get $rows) (local.get $cols)) (i32.const 2)))
    (local.set $o1 (i32.shl (local.get $dil) (i32.const 2)))
    (local.set $o2 (i32.shl (local.get $dil) (i32.const 3)))
    (local.set $r (i32.const 0))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $r) (local.get $rows)))
      (local.set $yp (i32.add (local.get $dy) (i32.mul (local.get $r) (local.get $dys))))
      (local.set $c (i32.const 0))
      (block $cd (loop $cl
        (br_if $cd (i32.ge_u (local.get $c) (local.get $cols)))
        (local.set $xp (i32.add (local.get $x) (i32.mul (local.get $c) (local.get $xs))))
        (local.set $a0 (v128.const f32x4 0 0 0 0)) (local.set $a1 (v128.const f32x4 0 0 0 0))
        (local.set $b0 (v128.const f32x4 0 0 0 0)) (local.set $b1 (v128.const f32x4 0 0 0 0))
        (local.set $e0 (v128.const f32x4 0 0 0 0)) (local.set $e1 (v128.const f32x4 0 0 0 0))
        (local.set $t (i32.const 0))
        (block $td (loop $tl
          (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
          (local.set $y0 (v128.load (i32.add (local.get $yp) (local.get $t))))
          (local.set $y1 (v128.load offset=16 (i32.add (local.get $yp) (local.get $t))))
          (local.set $q (i32.add (local.get $xp) (local.get $t)))
          (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (local.get $y0) (v128.load (local.get $q)))))
          (local.set $a1 (f32x4.add (local.get $a1) (f32x4.mul (local.get $y1) (v128.load offset=16 (local.get $q)))))
          (local.set $q (i32.sub (i32.add (local.get $xp) (local.get $t)) (local.get $o1)))
          (local.set $b0 (f32x4.add (local.get $b0) (f32x4.mul (local.get $y0) (v128.load (local.get $q)))))
          (local.set $b1 (f32x4.add (local.get $b1) (f32x4.mul (local.get $y1) (v128.load offset=16 (local.get $q)))))
          (local.set $q (i32.sub (i32.add (local.get $xp) (local.get $t)) (local.get $o2)))
          (local.set $e0 (f32x4.add (local.get $e0) (f32x4.mul (local.get $y0) (v128.load (local.get $q)))))
          (local.set $e1 (f32x4.add (local.get $e1) (f32x4.mul (local.get $y1) (v128.load offset=16 (local.get $q)))))
          (local.set $t (i32.add (local.get $t) (i32.const 32)))
          (br $tl)))
        (local.set $rc (i32.shl (i32.add (i32.mul (local.get $r) (local.get $cols)) (local.get $c)) (i32.const 2)))
        (local.set $wp (i32.add (i32.add (local.get $dw) (i32.mul (i32.const 0) (local.get $mat))) (local.get $rc)))
        (f32.store (local.get $wp) (f32.add (f32.load (local.get $wp)) (f32.add (f32.add (f32x4.extract_lane 0 (f32x4.add (local.get $e0) (local.get $e1))) (f32x4.extract_lane 1 (f32x4.add (local.get $e0) (local.get $e1)))) (f32.add (f32x4.extract_lane 2 (f32x4.add (local.get $e0) (local.get $e1))) (f32x4.extract_lane 3 (f32x4.add (local.get $e0) (local.get $e1)))))))
        (local.set $wp (i32.add (i32.add (local.get $dw) (i32.mul (i32.const 1) (local.get $mat))) (local.get $rc)))
        (f32.store (local.get $wp) (f32.add (f32.load (local.get $wp)) (f32.add (f32.add (f32x4.extract_lane 0 (f32x4.add (local.get $b0) (local.get $b1))) (f32x4.extract_lane 1 (f32x4.add (local.get $b0) (local.get $b1)))) (f32.add (f32x4.extract_lane 2 (f32x4.add (local.get $b0) (local.get $b1))) (f32x4.extract_lane 3 (f32x4.add (local.get $b0) (local.get $b1)))))))
        (local.set $wp (i32.add (i32.add (local.get $dw) (i32.mul (i32.const 2) (local.get $mat))) (local.get $rc)))
        (f32.store (local.get $wp) (f32.add (f32.load (local.get $wp)) (f32.add (f32.add (f32x4.extract_lane 0 (f32x4.add (local.get $a0) (local.get $a1))) (f32x4.extract_lane 1 (f32x4.add (local.get $a0) (local.get $a1)))) (f32.add (f32x4.extract_lane 2 (f32x4.add (local.get $a0) (local.get $a1))) (f32x4.extract_lane 3 (f32x4.add (local.get $a0) (local.get $a1)))))))
        (local.set $c (i32.add (local.get $c) (i32.const 1)))
        (br $cl)))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $rl)))
  )

  ;; Weight gradient of conv: dW[k][r][c] += sum_t dY[r][t] * X[c][t - dil*(K-1-k)], t over n (multiple of 16).
  ;; With K=1 and X a row of ones it sums rows (bias gradients).
  (func (export "wgrad")
    (param $dw i32) (param $K i32) (param $rows i32) (param $cols i32) (param $dil i32)
    (param $x i32) (param $xs i32) (param $dy i32) (param $dys i32) (param $n i32)
    (local $r i32) (local $k i32) (local $c i32) (local $t i32) (local $nb i32) (local $yp i32) (local $xp i32) (local $wp i32) (local $mat i32)
    (local $a0 v128) (local $a1 v128) (local $a2 v128) (local $a3 v128) (local $s v128)
    (if (i32.eq (local.get $K) (i32.const 3)) (then
      (call $wgrad3 (local.get $dw) (local.get $rows) (local.get $cols) (local.get $dil) (local.get $x) (local.get $xs) (local.get $dy) (local.get $dys) (local.get $n)) (return)))
    (if (i32.and (i32.eq (local.get $K) (i32.const 1)) (i32.eqz (i32.and (i32.or (local.get $rows) (local.get $cols)) (i32.const 1)))) (then
      (call $wgrad1b (local.get $dw) (local.get $rows) (local.get $cols) (local.get $x) (local.get $xs) (local.get $dy) (local.get $dys) (local.get $n)) (return)))
    (local.set $nb (i32.shl (local.get $n) (i32.const 2)))
    (local.set $mat (i32.shl (i32.mul (local.get $rows) (local.get $cols)) (i32.const 2)))
    (local.set $r (i32.const 0))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $r) (local.get $rows)))
      (local.set $yp (i32.add (local.get $dy) (i32.mul (local.get $r) (local.get $dys))))
      (local.set $k (i32.const 0))
      (block $kd (loop $kl
        (br_if $kd (i32.ge_u (local.get $k) (local.get $K)))
        (local.set $c (i32.const 0))
        (block $cd (loop $cl
          (br_if $cd (i32.ge_u (local.get $c) (local.get $cols)))
          (local.set $xp (i32.add (i32.add (local.get $x) (i32.mul (local.get $c) (local.get $xs)))
            (i32.shl (i32.mul (local.get $dil) (i32.sub (i32.add (local.get $k) (i32.const 1)) (local.get $K))) (i32.const 2))))
          (local.set $a0 (v128.const f32x4 0 0 0 0)) (local.set $a1 (v128.const f32x4 0 0 0 0))
          (local.set $a2 (v128.const f32x4 0 0 0 0)) (local.set $a3 (v128.const f32x4 0 0 0 0))
          (local.set $t (i32.const 0))
          (block $td (loop $tl
            (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
            (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (v128.load (i32.add (local.get $yp) (local.get $t))) (v128.load (i32.add (local.get $xp) (local.get $t))))))
            (local.set $a1 (f32x4.add (local.get $a1) (f32x4.mul (v128.load offset=16 (i32.add (local.get $yp) (local.get $t))) (v128.load offset=16 (i32.add (local.get $xp) (local.get $t))))))
            (local.set $a2 (f32x4.add (local.get $a2) (f32x4.mul (v128.load offset=32 (i32.add (local.get $yp) (local.get $t))) (v128.load offset=32 (i32.add (local.get $xp) (local.get $t))))))
            (local.set $a3 (f32x4.add (local.get $a3) (f32x4.mul (v128.load offset=48 (i32.add (local.get $yp) (local.get $t))) (v128.load offset=48 (i32.add (local.get $xp) (local.get $t))))))
            (local.set $t (i32.add (local.get $t) (i32.const 64)))
            (br $tl)))
          (local.set $s (f32x4.add (f32x4.add (local.get $a0) (local.get $a1)) (f32x4.add (local.get $a2) (local.get $a3))))
          (local.set $wp (i32.add (i32.add (local.get $dw) (i32.mul (local.get $k) (local.get $mat)))
            (i32.shl (i32.add (i32.mul (local.get $r) (local.get $cols)) (local.get $c)) (i32.const 2))))
          (f32.store (local.get $wp) (f32.add (f32.load (local.get $wp))
            (f32.add (f32.add (f32x4.extract_lane 0 (local.get $s)) (f32x4.extract_lane 1 (local.get $s)))
                     (f32.add (f32x4.extract_lane 2 (local.get $s)) (f32x4.extract_lane 3 (local.get $s))))))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (br $cl)))
        (local.set $k (i32.add (local.get $k) (i32.const 1)))
        (br $kl)))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $rl)))
  )

  ;; Accurate float tanh (rational minimax approximation, the same form Eigen uses), on one vector.
  (func $vtanh (param $x v128) (result v128)
    (local $x2 v128) (local $p v128) (local $q v128)
    (local.set $x (f32x4.min (f32x4.max (local.get $x) (v128.const f32x4 -7.99881172180175781 -7.99881172180175781 -7.99881172180175781 -7.99881172180175781))
                             (v128.const f32x4 7.99881172180175781 7.99881172180175781 7.99881172180175781 7.99881172180175781)))
    (local.set $x2 (f32x4.mul (local.get $x) (local.get $x)))
    (local.set $p (v128.const f32x4 -2.76076847742355e-16 -2.76076847742355e-16 -2.76076847742355e-16 -2.76076847742355e-16))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 2.00018790482477e-13 2.00018790482477e-13 2.00018790482477e-13 2.00018790482477e-13)))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 -8.60467152213735e-11 -8.60467152213735e-11 -8.60467152213735e-11 -8.60467152213735e-11)))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 5.12229709037114e-08 5.12229709037114e-08 5.12229709037114e-08 5.12229709037114e-08)))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 1.48572235717979e-05 1.48572235717979e-05 1.48572235717979e-05 1.48572235717979e-05)))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 6.37261928875436e-04 6.37261928875436e-04 6.37261928875436e-04 6.37261928875436e-04)))
    (local.set $p (f32x4.add (f32x4.mul (local.get $x2) (local.get $p)) (v128.const f32x4 4.89352455891786e-03 4.89352455891786e-03 4.89352455891786e-03 4.89352455891786e-03)))
    (local.set $p (f32x4.mul (local.get $x) (local.get $p)))
    (local.set $q (v128.const f32x4 1.19825839466702e-06 1.19825839466702e-06 1.19825839466702e-06 1.19825839466702e-06))
    (local.set $q (f32x4.add (f32x4.mul (local.get $x2) (local.get $q)) (v128.const f32x4 1.18534705686654e-04 1.18534705686654e-04 1.18534705686654e-04 1.18534705686654e-04)))
    (local.set $q (f32x4.add (f32x4.mul (local.get $x2) (local.get $q)) (v128.const f32x4 2.26843463243900e-03 2.26843463243900e-03 2.26843463243900e-03 2.26843463243900e-03)))
    (local.set $q (f32x4.add (f32x4.mul (local.get $x2) (local.get $q)) (v128.const f32x4 4.89352518554385e-03 4.89352518554385e-03 4.89352518554385e-03 4.89352518554385e-03)))
    (f32x4.div (local.get $p) (local.get $q))
  )
  (func (export "tanh1") (param $x f32) (result f32)
    (f32x4.extract_lane 0 (call $vtanh (f32x4.splat (local.get $x)))))

  ;; NAM's fast_tanh, exactly as written in the NAM core.
  (func $vfasttanh (param $x v128) (result v128)
    (local $ax v128) (local $x2 v128) (local $num v128) (local $den v128)
    (local.set $ax (f32x4.abs (local.get $x)))
    (local.set $x2 (f32x4.mul (local.get $x) (local.get $x)))
    (local.set $num (f32x4.mul (local.get $x)
      (f32x4.add (f32x4.add (v128.const f32x4 2.45550750702956 2.45550750702956 2.45550750702956 2.45550750702956)
                            (f32x4.mul (v128.const f32x4 2.45550750702956 2.45550750702956 2.45550750702956 2.45550750702956) (local.get $ax)))
                 (f32x4.mul (f32x4.add (v128.const f32x4 0.893229853513558 0.893229853513558 0.893229853513558 0.893229853513558)
                                       (f32x4.mul (v128.const f32x4 0.821226666969744 0.821226666969744 0.821226666969744 0.821226666969744) (local.get $ax)))
                            (local.get $x2)))))
    (local.set $den (f32x4.add (v128.const f32x4 2.44506634652299 2.44506634652299 2.44506634652299 2.44506634652299)
      (f32x4.mul (f32x4.add (v128.const f32x4 2.44506634652299 2.44506634652299 2.44506634652299 2.44506634652299) (local.get $x2))
                 (f32x4.abs (f32x4.add (local.get $x) (f32x4.mul (f32x4.mul (v128.const f32x4 0.814642734961073 0.814642734961073 0.814642734961073 0.814642734961073) (local.get $x)) (local.get $ax)))))))
    (f32x4.div (local.get $num) (local.get $den))
  )

  ;; One activation on one vector. kind: 0 none, 1 tanh, 2 hardtanh, 3 fasttanh, 4 relu, 5 leaky relu (p0),
  ;; 6 sigmoid, 7 silu, 8 hardswish, 9 leaky hardtanh (p0 min, p1 max, p2 min slope, p3 max slope), 10 softsign,
  ;; 11 fast sigmoid (NAM: 0.5*(fast_tanh(x/2)+1))
  (func $vact (param $k i32) (param $x v128) (param $p0 v128) (param $p1 v128) (param $p2 v128) (param $p3 v128) (result v128)
    (local $h v128) (local $zero v128) (local $one v128)
    (local.set $zero (v128.const f32x4 0 0 0 0))
    (local.set $one (v128.const f32x4 1 1 1 1))
    (if (i32.eq (local.get $k) (i32.const 1)) (then (return (call $vtanh (local.get $x)))))
    (if (i32.eq (local.get $k) (i32.const 2)) (then (return (f32x4.min (f32x4.max (local.get $x) (v128.const f32x4 -1 -1 -1 -1)) (local.get $one)))))
    (if (i32.eq (local.get $k) (i32.const 3)) (then (return (call $vfasttanh (local.get $x)))))
    (if (i32.eq (local.get $k) (i32.const 4)) (then (return (f32x4.max (local.get $x) (local.get $zero)))))
    (if (i32.eq (local.get $k) (i32.const 5)) (then (return
      (v128.bitselect (local.get $x) (f32x4.mul (local.get $x) (local.get $p0)) (f32x4.gt (local.get $x) (local.get $zero))))))
    (if (i32.eq (local.get $k) (i32.const 6)) (then (return
      (f32x4.add (v128.const f32x4 0.5 0.5 0.5 0.5) (f32x4.mul (v128.const f32x4 0.5 0.5 0.5 0.5)
        (call $vtanh (f32x4.mul (v128.const f32x4 0.5 0.5 0.5 0.5) (local.get $x))))))))
    (if (i32.eq (local.get $k) (i32.const 7)) (then (return
      (f32x4.mul (local.get $x) (f32x4.add (v128.const f32x4 0.5 0.5 0.5 0.5) (f32x4.mul (v128.const f32x4 0.5 0.5 0.5 0.5)
        (call $vtanh (f32x4.mul (v128.const f32x4 0.5 0.5 0.5 0.5) (local.get $x)))))))))
    (if (i32.eq (local.get $k) (i32.const 8)) (then (return
      (f32x4.mul (f32x4.mul (local.get $x) (f32x4.min (f32x4.max (f32x4.add (local.get $x) (v128.const f32x4 3 3 3 3)) (local.get $zero)) (v128.const f32x4 6 6 6 6)))
                 (v128.const f32x4 0.16666666666666666 0.16666666666666666 0.16666666666666666 0.16666666666666666)))))
    (if (i32.eq (local.get $k) (i32.const 9)) (then
      (local.set $h (v128.bitselect
        (f32x4.add (f32x4.mul (f32x4.sub (local.get $x) (local.get $p0)) (local.get $p2)) (local.get $p0))
        (local.get $x) (f32x4.lt (local.get $x) (local.get $p0))))
      (return (v128.bitselect
        (f32x4.add (f32x4.mul (f32x4.sub (local.get $x) (local.get $p1)) (local.get $p3)) (local.get $p1))
        (local.get $h) (f32x4.gt (local.get $x) (local.get $p1))))))
    (if (i32.eq (local.get $k) (i32.const 10)) (then (return
      (f32x4.div (local.get $x) (f32x4.add (local.get $one) (f32x4.abs (local.get $x)))))))
    (if (i32.eq (local.get $k) (i32.const 11)) (then (return
      (f32x4.mul (v128.const f32x4 0.5 0.5 0.5 0.5) (f32x4.add (call $vfasttanh (f32x4.mul (v128.const f32x4 0.5 0.5 0.5 0.5) (local.get $x))) (local.get $one))))))
    (local.get $x)
  )

;; tanh over rows, two vectors per step, written out in full (the hot path of every Tanh model)
  (func $tanhRows (param $y i32) (param $rows i32) (param $ys i32) (param $n i32)
    (local $r i32) (local $t i32) (local $nb i32) (local $yp i32) (local $p i32)
    (local $x0 v128) (local $x1 v128) (local $z0 v128) (local $z1 v128)
    (local.set $nb (i32.shl (local.get $n) (i32.const 2)))
    (local.set $r (i32.const 0))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $r) (local.get $rows)))
      (local.set $yp (i32.add (local.get $y) (i32.mul (local.get $r) (local.get $ys))))
      (local.set $t (i32.const 0))
      (block $td (loop $tl
        (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
        (local.set $p (i32.add (local.get $yp) (local.get $t)))
        (local.set $x0 (f32x4.min (f32x4.max (v128.load (local.get $p)) (v128.const f32x4 -7.99881172180175781 -7.99881172180175781 -7.99881172180175781 -7.99881172180175781)) (v128.const f32x4 7.99881172180175781 7.99881172180175781 7.99881172180175781 7.99881172180175781)))
        (local.set $x1 (f32x4.min (f32x4.max (v128.load offset=16 (local.get $p)) (v128.const f32x4 -7.99881172180175781 -7.99881172180175781 -7.99881172180175781 -7.99881172180175781)) (v128.const f32x4 7.99881172180175781 7.99881172180175781 7.99881172180175781 7.99881172180175781)))
        (local.set $z0 (f32x4.mul (local.get $x0) (local.get $x0)))
        (local.set $z1 (f32x4.mul (local.get $x1) (local.get $x1)))
        (v128.store (local.get $p) (f32x4.div (f32x4.mul (local.get $x0) (f32x4.add (f32x4.mul (local.get $z0) (f32x4.add (f32x4.mul (local.get $z0) (f32x4.add (f32x4.mul (local.get $z0) (f32x4.add (f32x4.mul (local.get $z0) (f32x4.add (f32x4.mul (local.get $z0) (f32x4.add (f32x4.mul (local.get $z0) (v128.const f32x4 -2.76076847742355e-16 -2.76076847742355e-16 -2.76076847742355e-16 -2.76076847742355e-16)) (v128.const f32x4 2.00018790482477e-13 2.00018790482477e-13 2.00018790482477e-13 2.00018790482477e-13))) (v128.const f32x4 -8.60467152213735e-11 -8.60467152213735e-11 -8.60467152213735e-11 -8.60467152213735e-11))) (v128.const f32x4 5.12229709037114e-08 5.12229709037114e-08 5.12229709037114e-08 5.12229709037114e-08))) (v128.const f32x4 1.48572235717979e-05 1.48572235717979e-05 1.48572235717979e-05 1.48572235717979e-05))) (v128.const f32x4 6.37261928875436e-04 6.37261928875436e-04 6.37261928875436e-04 6.37261928875436e-04))) (v128.const f32x4 4.89352455891786e-03 4.89352455891786e-03 4.89352455891786e-03 4.89352455891786e-03))) (f32x4.add (f32x4.mul (local.get $z0) (f32x4.add (f32x4.mul (local.get $z0) (f32x4.add (f32x4.mul (local.get $z0) (v128.const f32x4 1.19825839466702e-06 1.19825839466702e-06 1.19825839466702e-06 1.19825839466702e-06)) (v128.const f32x4 1.18534705686654e-04 1.18534705686654e-04 1.18534705686654e-04 1.18534705686654e-04))) (v128.const f32x4 2.26843463243900e-03 2.26843463243900e-03 2.26843463243900e-03 2.26843463243900e-03))) (v128.const f32x4 4.89352518554385e-03 4.89352518554385e-03 4.89352518554385e-03 4.89352518554385e-03))))
        (v128.store offset=16 (local.get $p) (f32x4.div (f32x4.mul (local.get $x1) (f32x4.add (f32x4.mul (local.get $z1) (f32x4.add (f32x4.mul (local.get $z1) (f32x4.add (f32x4.mul (local.get $z1) (f32x4.add (f32x4.mul (local.get $z1) (f32x4.add (f32x4.mul (local.get $z1) (f32x4.add (f32x4.mul (local.get $z1) (v128.const f32x4 -2.76076847742355e-16 -2.76076847742355e-16 -2.76076847742355e-16 -2.76076847742355e-16)) (v128.const f32x4 2.00018790482477e-13 2.00018790482477e-13 2.00018790482477e-13 2.00018790482477e-13))) (v128.const f32x4 -8.60467152213735e-11 -8.60467152213735e-11 -8.60467152213735e-11 -8.60467152213735e-11))) (v128.const f32x4 5.12229709037114e-08 5.12229709037114e-08 5.12229709037114e-08 5.12229709037114e-08))) (v128.const f32x4 1.48572235717979e-05 1.48572235717979e-05 1.48572235717979e-05 1.48572235717979e-05))) (v128.const f32x4 6.37261928875436e-04 6.37261928875436e-04 6.37261928875436e-04 6.37261928875436e-04))) (v128.const f32x4 4.89352455891786e-03 4.89352455891786e-03 4.89352455891786e-03 4.89352455891786e-03))) (f32x4.add (f32x4.mul (local.get $z1) (f32x4.add (f32x4.mul (local.get $z1) (f32x4.add (f32x4.mul (local.get $z1) (v128.const f32x4 1.19825839466702e-06 1.19825839466702e-06 1.19825839466702e-06 1.19825839466702e-06)) (v128.const f32x4 1.18534705686654e-04 1.18534705686654e-04 1.18534705686654e-04 1.18534705686654e-04))) (v128.const f32x4 2.26843463243900e-03 2.26843463243900e-03 2.26843463243900e-03 2.26843463243900e-03))) (v128.const f32x4 4.89352518554385e-03 4.89352518554385e-03 4.89352518554385e-03 4.89352518554385e-03))))
        (local.set $t (i32.add (local.get $t) (i32.const 32)))
        (br $tl)))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $rl)))
  )

  ;; In-place activation over rows.
  (func (export "act") (param $kind i32) (param $y i32) (param $rows i32) (param $ys i32) (param $n i32)
    (param $a f32) (param $b f32) (param $c f32) (param $d f32)
    (local $r i32) (local $t i32) (local $nb i32) (local $yp i32)
    (local $p0 v128) (local $p1 v128) (local $p2 v128) (local $p3 v128)
    (if (i32.eqz (local.get $kind)) (then (return)))
    (if (i32.eq (local.get $kind) (i32.const 1)) (then (call $tanhRows (local.get $y) (local.get $rows) (local.get $ys) (local.get $n)) (return)))
    (local.set $p0 (f32x4.splat (local.get $a))) (local.set $p1 (f32x4.splat (local.get $b)))
    (local.set $p2 (f32x4.splat (local.get $c))) (local.set $p3 (f32x4.splat (local.get $d)))
    (local.set $nb (i32.shl (local.get $n) (i32.const 2)))
    (local.set $r (i32.const 0))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $r) (local.get $rows)))
      (local.set $yp (i32.add (local.get $y) (i32.mul (local.get $r) (local.get $ys))))
      (local.set $t (i32.const 0))
      (block $td (loop $tl
        (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
        (v128.store (i32.add (local.get $yp) (local.get $t))
          (call $vact (local.get $kind) (v128.load (i32.add (local.get $yp) (local.get $t)))
            (local.get $p0) (local.get $p1) (local.get $p2) (local.get $p3)))
        (local.set $t (i32.add (local.get $t) (i32.const 16)))
        (br $tl)))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $rl)))
  )

  ;; Elementwise ops over rows. op: 0 y+=x, 1 y*=x, 2 y=x, 3 y*=s (x ignored), 4 y=0 (x ignored), 5 y=x*s, 6 y*=(1-x*x)
  ;; The op is picked once per row, so the inner loops stay tight. Copies and clears use bulk memory.
  (func (export "ew") (param $op i32) (param $y i32) (param $ys i32) (param $x i32) (param $xs i32) (param $rows i32) (param $n i32) (param $s f32)
    (local $r i32) (local $t i32) (local $nb i32) (local $yp i32) (local $xp i32) (local $sv v128) (local $q i32) (local $u i32)
    (local.set $sv (f32x4.splat (local.get $s)))
    (local.set $nb (i32.shl (local.get $n) (i32.const 2)))
    (local.set $r (i32.const 0))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $r) (local.get $rows)))
      (local.set $yp (i32.add (local.get $y) (i32.mul (local.get $r) (local.get $ys))))
      (local.set $xp (i32.add (local.get $x) (i32.mul (local.get $r) (local.get $xs))))
      (if (i32.eq (local.get $op) (i32.const 2)) (then (memory.copy (local.get $yp) (local.get $xp) (local.get $nb))))
      (if (i32.eq (local.get $op) (i32.const 4)) (then (memory.fill (local.get $yp) (i32.const 0) (local.get $nb))))
      (if (i32.eq (local.get $op) (i32.const 0)) (then
        (local.set $t (i32.const 0))
        (block $td (loop $tl
          (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
          (local.set $q (i32.add (local.get $yp) (local.get $t))) (local.set $u (i32.add (local.get $xp) (local.get $t)))
          (v128.store (local.get $q) (f32x4.add (v128.load (local.get $q)) (v128.load (local.get $u))))
          (v128.store offset=16 (local.get $q) (f32x4.add (v128.load offset=16 (local.get $q)) (v128.load offset=16 (local.get $u))))
          (local.set $t (i32.add (local.get $t) (i32.const 32)))
          (br $tl)))))
      (if (i32.eq (local.get $op) (i32.const 1)) (then
        (local.set $t (i32.const 0))
        (block $td (loop $tl
          (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
          (local.set $q (i32.add (local.get $yp) (local.get $t))) (local.set $u (i32.add (local.get $xp) (local.get $t)))
          (v128.store (local.get $q) (f32x4.mul (v128.load (local.get $q)) (v128.load (local.get $u))))
          (v128.store offset=16 (local.get $q) (f32x4.mul (v128.load offset=16 (local.get $q)) (v128.load offset=16 (local.get $u))))
          (local.set $t (i32.add (local.get $t) (i32.const 32)))
          (br $tl)))))
      (if (i32.eq (local.get $op) (i32.const 3)) (then
        (local.set $t (i32.const 0))
        (block $td (loop $tl
          (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
          (local.set $q (i32.add (local.get $yp) (local.get $t))) (local.set $u (i32.add (local.get $xp) (local.get $t)))
          (v128.store (local.get $q) (f32x4.mul (v128.load (local.get $q)) (local.get $sv)))
          (v128.store offset=16 (local.get $q) (f32x4.mul (v128.load offset=16 (local.get $q)) (local.get $sv)))
          (local.set $t (i32.add (local.get $t) (i32.const 32)))
          (br $tl)))))
      (if (i32.eq (local.get $op) (i32.const 5)) (then
        (local.set $t (i32.const 0))
        (block $td (loop $tl
          (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
          (local.set $q (i32.add (local.get $yp) (local.get $t))) (local.set $u (i32.add (local.get $xp) (local.get $t)))
          (v128.store (local.get $q) (f32x4.mul (v128.load (local.get $u)) (local.get $sv)))
          (v128.store offset=16 (local.get $q) (f32x4.mul (v128.load offset=16 (local.get $u)) (local.get $sv)))
          (local.set $t (i32.add (local.get $t) (i32.const 32)))
          (br $tl)))))
      (if (i32.eq (local.get $op) (i32.const 6)) (then
        (local.set $t (i32.const 0))
        (block $td (loop $tl
          (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
          (local.set $q (i32.add (local.get $yp) (local.get $t))) (local.set $u (i32.add (local.get $xp) (local.get $t)))
          (v128.store (local.get $q) (f32x4.mul (v128.load (local.get $q)) (f32x4.sub (v128.const f32x4 1 1 1 1) (f32x4.mul (v128.load (local.get $u)) (v128.load (local.get $u))))))
          (v128.store offset=16 (local.get $q) (f32x4.mul (v128.load offset=16 (local.get $q)) (f32x4.sub (v128.const f32x4 1 1 1 1) (f32x4.mul (v128.load offset=16 (local.get $u)) (v128.load offset=16 (local.get $u))))))
          (local.set $t (i32.add (local.get $t) (i32.const 32)))
          (br $tl)))))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $rl)))
  )

  ;; Blending: y = a*y + (1-a)*pre, row by row. a is the activated blend rows, pre is the saved pre-activation.
  (func (export "blend") (param $y i32) (param $ys i32) (param $a i32) (param $as i32) (param $p i32) (param $ps i32) (param $rows i32) (param $n i32)
    (local $r i32) (local $t i32) (local $nb i32) (local $yp i32) (local $ap i32) (local $pp i32) (local $av v128)
    (local.set $nb (i32.shl (local.get $n) (i32.const 2)))
    (local.set $r (i32.const 0))
    (block $rd (loop $rl
      (br_if $rd (i32.ge_u (local.get $r) (local.get $rows)))
      (local.set $yp (i32.add (local.get $y) (i32.mul (local.get $r) (local.get $ys))))
      (local.set $ap (i32.add (local.get $a) (i32.mul (local.get $r) (local.get $as))))
      (local.set $pp (i32.add (local.get $p) (i32.mul (local.get $r) (local.get $ps))))
      (local.set $t (i32.const 0))
      (block $td (loop $tl
        (br_if $td (i32.ge_u (local.get $t) (local.get $nb)))
        (local.set $av (v128.load (i32.add (local.get $ap) (local.get $t))))
        (v128.store (i32.add (local.get $yp) (local.get $t))
          (f32x4.add (f32x4.mul (local.get $av) (v128.load (i32.add (local.get $yp) (local.get $t))))
                     (f32x4.mul (f32x4.sub (v128.const f32x4 1 1 1 1) (local.get $av)) (v128.load (i32.add (local.get $pp) (local.get $t))))))
        (local.set $t (i32.add (local.get $t) (i32.const 16)))
        (br $tl)))
      (local.set $r (i32.add (local.get $r) (i32.const 1)))
      (br $rl)))
  )

  ;; ---------------------------------------------------------------- LSTM (one stream)
  ;; Gates live in blocks of Hp floats (H rounded up to 4): i, f, g, o. wT is column major: [cols][4*Hp].
  ;; xh points at this layer's input followed by its hidden state. Padded lanes stay at zero.
  (func $sig (param $x v128) (result v128)
    (f32x4.add (v128.const f32x4 0.5 0.5 0.5 0.5)
      (f32x4.mul (v128.const f32x4 0.5 0.5 0.5 0.5) (call $vtanh (f32x4.mul (v128.const f32x4 0.5 0.5 0.5 0.5) (local.get $x))))))
  (func $lstm_step (param $wT i32) (param $b i32) (param $cols i32) (param $Hp i32) (param $xh i32) (param $hoff i32) (param $c i32) (param $g i32)
    (local $G i32) (local $j i32) (local $r i32) (local $wp i32) (local $xv v128) (local $e i32) (local $hb i32)
    (local $iv v128) (local $fv v128) (local $gv v128) (local $ov v128) (local $cv v128)
    (local.set $hb (i32.shl (local.get $Hp) (i32.const 2)))
    (local.set $G (i32.shl (local.get $Hp) (i32.const 4)))
    (local.set $r (i32.const 0))
    (block $d0 (loop $l0
      (br_if $d0 (i32.ge_u (local.get $r) (local.get $G)))
      (v128.store (i32.add (local.get $g) (local.get $r)) (v128.load (i32.add (local.get $b) (local.get $r))))
      (local.set $r (i32.add (local.get $r) (i32.const 16)))
      (br $l0)))
    (local.set $wp (local.get $wT))
    (local.set $j (i32.const 0))
    (block $d1 (loop $l1
      (br_if $d1 (i32.ge_u (local.get $j) (local.get $cols)))
      (local.set $xv (v128.load32_splat (i32.add (local.get $xh) (i32.shl (local.get $j) (i32.const 2)))))
      (local.set $r (i32.const 0))
      (block $d2 (loop $l2
        (br_if $d2 (i32.ge_u (local.get $r) (local.get $G)))
        (v128.store (i32.add (local.get $g) (local.get $r))
          (f32x4.add (v128.load (i32.add (local.get $g) (local.get $r)))
                     (f32x4.mul (v128.load (i32.add (local.get $wp) (local.get $r))) (local.get $xv))))
        (local.set $r (i32.add (local.get $r) (i32.const 16)))
        (br $l2)))
      (local.set $wp (i32.add (local.get $wp) (local.get $G)))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $l1)))
    (local.set $e (i32.const 0))
    (block $d3 (loop $l3
      (br_if $d3 (i32.ge_u (local.get $e) (local.get $hb)))
      (local.set $iv (call $sig (v128.load (i32.add (local.get $g) (local.get $e)))))
      (local.set $fv (call $sig (v128.load (i32.add (i32.add (local.get $g) (local.get $hb)) (local.get $e)))))
      (local.set $gv (call $vtanh (v128.load (i32.add (i32.add (local.get $g) (i32.shl (local.get $hb) (i32.const 1))) (local.get $e)))))
      (local.set $ov (call $sig (v128.load (i32.add (i32.add (local.get $g) (i32.mul (local.get $hb) (i32.const 3))) (local.get $e)))))
      (local.set $cv (f32x4.add (f32x4.mul (local.get $fv) (v128.load (i32.add (local.get $c) (local.get $e)))) (f32x4.mul (local.get $iv) (local.get $gv))))
      (v128.store (i32.add (local.get $c) (local.get $e)) (local.get $cv))
      (v128.store (i32.add (i32.add (local.get $xh) (local.get $hoff)) (local.get $e)) (f32x4.mul (local.get $ov) (call $vtanh (local.get $cv))))
      (local.set $e (i32.add (local.get $e) (i32.const 16)))
      (br $l3)))
  )
  ;; Run n samples through L layers and the head. tab holds (wT, b, c) per layer as i32s.
  ;; Layer 0 reads xh = [x, 0, 0, 0, h0]; layer l reads [h(l-1), h(l)], all in one strip at $xh.
  (func (export "lstm_run") (param $L i32) (param $Hp i32) (param $tab i32) (param $xh i32) (param $g i32)
    (param $hw i32) (param $hb f32) (param $x i32) (param $y i32) (param $n i32)
    (local $t i32) (local $l i32) (local $tp i32) (local $hlast i32) (local $acc v128) (local $e i32) (local $hbytes i32) (local $s f32)
    (local.set $hbytes (i32.shl (local.get $Hp) (i32.const 2)))
    (local.set $hlast (i32.add (i32.add (local.get $xh) (i32.const 16)) (i32.mul (i32.sub (local.get $L) (i32.const 1)) (local.get $hbytes))))
    (local.set $t (i32.const 0))
    (block $dt (loop $lt
      (br_if $dt (i32.ge_u (local.get $t) (local.get $n)))
      (f32.store (local.get $xh) (f32.load (i32.add (local.get $x) (i32.shl (local.get $t) (i32.const 2)))))
      (local.set $l (i32.const 0)) (local.set $tp (local.get $tab))
      (block $dl (loop $ll
        (br_if $dl (i32.ge_u (local.get $l) (local.get $L)))
        (if (i32.eqz (local.get $l))
          (then (call $lstm_step (i32.load (local.get $tp)) (i32.load offset=4 (local.get $tp)) (i32.add (i32.const 4) (local.get $Hp)) (local.get $Hp)
                  (local.get $xh) (i32.const 16) (i32.load offset=8 (local.get $tp)) (local.get $g)))
          (else (call $lstm_step (i32.load (local.get $tp)) (i32.load offset=4 (local.get $tp)) (i32.shl (local.get $Hp) (i32.const 1)) (local.get $Hp)
                  (i32.add (i32.add (local.get $xh) (i32.const 16)) (i32.mul (i32.sub (local.get $l) (i32.const 1)) (local.get $hbytes)))
                  (local.get $hbytes) (i32.load offset=8 (local.get $tp)) (local.get $g))))
        (local.set $tp (i32.add (local.get $tp) (i32.const 12)))
        (local.set $l (i32.add (local.get $l) (i32.const 1)))
        (br $ll)))
      (local.set $acc (v128.const f32x4 0 0 0 0))
      (local.set $e (i32.const 0))
      (block $de (loop $le
        (br_if $de (i32.ge_u (local.get $e) (local.get $hbytes)))
        (local.set $acc (f32x4.add (local.get $acc) (f32x4.mul (v128.load (i32.add (local.get $hw) (local.get $e))) (v128.load (i32.add (local.get $hlast) (local.get $e))))))
        (local.set $e (i32.add (local.get $e) (i32.const 16)))
        (br $le)))
      (local.set $s (f32.add (f32.add (f32x4.extract_lane 0 (local.get $acc)) (f32x4.extract_lane 1 (local.get $acc)))
                             (f32.add (f32x4.extract_lane 2 (local.get $acc)) (f32x4.extract_lane 3 (local.get $acc)))))
      (f32.store (i32.add (local.get $y) (i32.shl (local.get $t) (i32.const 2))) (f32.add (local.get $s) (local.get $hb)))
      (local.set $t (i32.add (local.get $t) (i32.const 1)))
      (br $lt)))
  )
)
