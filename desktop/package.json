{
  "name": "neon-peach",
  "productName": "Neon Peach",
  "version": "2.0.0",
  "description": "Bass effects workstation with a pedal and plugin cloner",
  "author": "Shane",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.neonpeach.app",
    "productName": "Neon Peach",
    "copyright": "Neon Peach",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "native/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "README.txt",
        "to": "README.txt"
      }
    ],
    "asar": true,
    "asarUnpack": ["native/**"],
    "fileAssociations": [
      {
        "ext": "nam",
        "name": "NAM Model",
        "description": "Neural Amp Modeler model",
        "role": "Viewer",
        "icon": "icon"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neon Peach",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Neon-Peach-Setup-${version}.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Neon Peach listens to your audio interface input to hear your bass and to copy pedals.",
        "LSMinimumSystemVersion": "12.0"
      }
    }
  }
}
